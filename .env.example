# URL de la implementación de Apps Script (termina en /exec)
GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Token que muestra generarToken() en Apps Script
GAS_TOKEN=
# ID de cliente OAuth de Google (tipo "Aplicación web") para "Ingresar con Google"
GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
# Mails habilitados para entrar, separados por coma
USUARIOS=direcciontecnicasurcherie@gmail.com,cxsurcherie@gmail.com
# Clave para firmar la sesión (cualquier texto largo y aleatorio)
SESSION_SECRET=
# DEMO=1 usa datos de ejemplo en memoria (no toca las planillas)
DEMO=
